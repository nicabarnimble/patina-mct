# Copy outside Git and replace every placeholder. Never put secrets in this file.
MCT_APPROVAL_ORIGIN=https://approval.example.test
MCT_APPROVAL_LISTEN=127.0.0.1:8443
MCT_APPROVAL_UPSTREAM=https://127.0.0.1:9443
MCT_APPROVAL_UPSTREAM_CA_FILE=/private/queue-ca.pem
MCT_APPROVAL_TLS_CERT_FILE=/private/approval-cert.pem
MCT_APPROVAL_TLS_KEY_FILE=/private/approval-key.pem
MCT_APPROVAL_SESSION_SECONDS=900

MCT_OIDC_ISSUER=https://pocket-id.example.test
MCT_OIDC_CLIENT_ID=mct-approval
MCT_OIDC_CLIENT_SECRET_FILE=/private/oidc-client-secret
MCT_OIDC_ALLOWED_SUBJECTS_FILE=/private/allowed-subjects.json
MCT_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
